{
  "name": "browser-agent",
  "version": "1.0.0",
  "description": "A token-first Firefox sidebar agent for user-supplied AI providers.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run icons && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "token:budgets": "vite-node scripts/print-budgets.ts",
    "test:e2e": "npm run package && node e2e/firefox.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test:coverage && npm run build && npm run lint:addon && npm run audit:deps",
    "audit:deps": "env -u npm_config_allow_scripts npm audit --omit=dev",
    "lint:addon": "npm run build && web-ext lint --source-dir dist --no-config-discovery",
    "start:firefox": "npm run build && web-ext run --source-dir dist --no-config-discovery",
    "package": "npm run build && web-ext build --source-dir dist --artifacts-dir web-ext-artifacts --overwrite-dest --no-config-discovery",
    "package:source": "node scripts/package-source.mjs",
    "serve:preview": "vite preview --port 4173"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.0.1",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "selenium-webdriver": "^4.34.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^6.0.5",
    "vitest": "^3.0.4",
    "web-ext": "^10.6.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
